# ==============================================================================
# DermAI Production & Development Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and substitute secrets with strong values.
# NEVER commit the active '.env' file containing production credentials to Git.
# ==============================================================================

# Application Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
# Required in production. Minimum 32 random characters recommended.
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_hex_secret

# Token Expiration in Minutes (e.g. 1440 for 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated, explicit protocols and ports, no wildcards)
ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=dermai_production
POSTGRES_USER=dermai_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password_32_chars_min
POSTGRES_PORT=5432

# Database Connection URL (Constructed from above credentials for Docker or external)
DATABASE_URL=postgresql+psycopg2://dermai_admin:replace_with_a_secure_database_password_32_chars_min@postgres:5432/dermai_production
# For local SQLite development override with:
# DATABASE_URL=sqlite:///./dermai.db

# Seed Demo Administrative & Clinical Accounts on Startup: 'true' or 'false'
# Set to 'false' for production deployments
SEED_DEMO_USERS=false

# Upload Constraints (Maximum allowed image size in Megabytes)
MAX_FILE_SIZE_MB=15

# Ports Configuration
BACKEND_PORT=8000
FRONTEND_PORT=80

# Frontend API Base URL (Leave blank to use the Nginx reverse proxy at /api)
# Or set explicitly for decoupled hosting (e.g. https://api.dermai.hospital.org)
VITE_API_BASE_URL=
