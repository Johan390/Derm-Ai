**/test_*.db
**/test_*.py
**/htmlcov/
**/.coverage

# Node.js dependencies and build output
**/node_modules/
**/dist/
**/build/

# Large research dataset
ml_dataset/HAM10000/

# Logs and temporary files
**/*.log
**/*.tmp
**/.DS_Store